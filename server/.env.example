# Optional: eigene marktguru-Keys. Leer lassen = Server liest die öffentlichen Web-Keys selbst aus.
MARKTGURU_API_KEY=
MARKTGURU_CLIENT_KEY=
MARKTGURU_AUTO_KEYS=1

SEARCH_TERM=monster energy
DEFAULT_RADIUS_KM=5
CACHE_TTL_SECONDS=1800

# Richtpreise für Märkte ohne Angebot anzeigen (1/0)
INCLUDE_REFERENCE_PRICES=1
